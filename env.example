SINOTRUST_ENV=production
SINOTRUST_TRUST_PROXY=1
SINOTRUST_REGION=eu-central
SINOTRUST_DATA_RESIDENCY=EU
SINOTRUST_RELOAD=0
# Railway injects PORT automatically.
# Add Railway PostgreSQL and set SINOTRUST_DATABASE_URL to its DATABASE_URL reference,
# or this build also accepts DATABASE_URL directly.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
# Railway real infrastructure (recommended)
# DATABASE_URL and REDIS_URL can be added as Railway service references.
# Railway Bucket -> "Add to Service" -> AWS SDK (Generic) injects:
# AWS_ENDPOINT_URL, AWS_S3_BUCKET_NAME, AWS_DEFAULT_REGION,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
# app.py automatically selects S3 object storage when a bucket variable is present.
# Optional explicit override:
# SINOTRUST_OBJECT_STORAGE=s3
